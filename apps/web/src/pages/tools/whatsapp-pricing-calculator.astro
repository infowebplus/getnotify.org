---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="WhatsApp Pricing Calculator - GetNotify" description="Estimate your WhatsApp Business API messaging costs.">
  <section class="section bg-white dark:bg-neutral-900">
    <div class="container-custom max-w-lg mx-auto">
      <h1 class="heading-lg mb-4">Pricing calculator</h1>
      <p class="text-body-sm mb-8">Rough estimate based on conversation tiers. Actual pricing depends on country and conversation type.</p>
      <div class="card">
        <form class="space-y-4" id="calc-form">
          <div><label for="messages" class="form-label">Messages per month (approx.)</label><input type="number" id="messages" name="messages" class="form-input" value="1000" min="1" /></div>
          <button type="submit" class="btn-primary w-full">Estimate</button>
        </form>
        <p id="result" class="mt-4 text-sm text-neutral-600 dark:text-neutral-400 hidden"></p>
      </div>
    </div>
  </section>
  <script is:inline define:vars={{}}>
    document.getElementById('calc-form')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const form = e.target;
      const n = Math.max(0, parseInt(form.querySelector('[name=messages]')?.value || '0', 10) || 0);
      const el = document.getElementById('result');
      if (el) {
        el.textContent = 'For ' + n + ' messages/month, consider our Pro plan ($29/mo). WhatsApp conversation fees apply per Meta\'s pricing.';
        el.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
