---
const target = '/tools/whatsapp-link-generator/';
const fullUrl = `${import.meta.env.SITE || 'https://getnotify.org'}${target}`;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tools - GetNotify</title>
    <link rel="canonical" href={fullUrl} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline>
      window.location.replace('/tools/whatsapp-link-generator/');
    </script>
  </head>
  <body>
    <p>Redirecting to <a href={target}>WhatsApp Link Generator</a>…</p>
  </body>
</html>
