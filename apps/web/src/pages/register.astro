---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const globals = Object.fromEntries((await getCollection('globals')).map((e: CollectionEntry<'globals'>) => [e.id, e.data]));
const content = (globals.content || {}) as Record<string, unknown>;
const dashboard = (content.dashboard || {}) as Record<string, string>;
const trialBenefits = (content.trialBenefits || []) as string[];
const baseUrl = (dashboard.baseUrl ?? '').replace(/\/$/, '');
const registerPath = dashboard.registerPath ?? '/admin/register';
const registerLabel = dashboard.registerLabel ?? 'Create account';
const dashboardRegisterUrl = baseUrl ? `${baseUrl}${registerPath.startsWith('/') ? registerPath : `/${registerPath}`}` : '';
---

<BaseLayout title="Sign up - GetNotify" description="Create your GetNotify account and start sending WhatsApp notifications. Free trial, no credit card required.">
  <section class="section bg-white dark:bg-neutral-900 min-h-[calc(100vh-12rem)] flex flex-col justify-center">
    <div class="container-custom max-w-md mx-auto">
      <div class="text-center mb-10">
        <span class="badge-primary mb-4">Get started</span>
        <h1 class="heading-lg mb-4">Create your account</h1>
        <p class="text-body max-w-xl mx-auto mb-4">
          Start your free trial. No credit card required. Create your account in the dashboard and begin sending WhatsApp notifications.
        </p>
        {trialBenefits.length > 0 && (
          <ul class="flex flex-wrap justify-center gap-2">
            {trialBenefits.map((b) => (
              <li class="text-xs font-medium text-primary-600 dark:text-primary-400 bg-primary-50 dark:bg-primary-950/50 px-3 py-1 rounded-full">{b}</li>
            ))}
          </ul>
        )}
      </div>
      <div class="card p-6 md:p-8">
        <h2 class="text-lg font-semibold text-neutral-900 dark:text-white mb-6">Sign up for GetNotify</h2>
        {dashboardRegisterUrl ? (
          <div class="space-y-5">
            <a
              href={dashboardRegisterUrl}
              class="btn-primary w-full btn-lg flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
              </svg>
              {registerLabel}
            </a>
            <div class="pt-4 border-t border-neutral-200 dark:border-neutral-700">
              <p class="text-xs text-neutral-500 dark:text-neutral-400 text-center">
                You’ll be taken to <span class="font-mono text-neutral-700 dark:text-neutral-300">dashboard.getnotify.org</span> to create your account securely.
              </p>
            </div>
          </div>
        ) : (
          <div class="space-y-4">
            <p class="text-body-sm text-neutral-600 dark:text-neutral-400">
              Dashboard sign-up URL is not configured. Set <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded">content.dashboard.baseUrl</code> and <code class="text-xs bg-neutral-100 dark:bg-neutral-800 px-2 py-1 rounded">registerPath</code> in your content globals.
            </p>
            <a href="/contact/" class="link text-sm">Request access? Contact us</a>
          </div>
        )}
      </div>
      <p class="text-center text-body-sm mt-6">
        Already have an account? <a href="/login/" class="link font-medium">Log in</a>
      </p>
    </div>
  </section>
</BaseLayout>
