---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const globals = Object.fromEntries((await getCollection('globals')).map((e: CollectionEntry<'globals'>) => [e.id, e.data]));
const plansData = (globals.plans || {}) as Record<string, unknown>;
const planList = (plansData.plans || []) as Array<Record<string, unknown>>;
const installationFee = (plansData.installationFee || null) as {
  tiers: Array<{ plan: string; price: string }>;
} | null;
const comparison = (plansData.comparison || { categories: [] }) as {
  categories: Array<{
    name: string;
    icon: string;
    features: Array<Record<string, string>>;
  }>;
};
const planIds = ['basic', 'core', 'agency'] as const;

function setupForPlan(plan: Record<string, unknown>) {
  const name = String(plan.name).toLowerCase();
  return (
    installationFee?.tiers.find((t) => {
      const tp = t.plan.toLowerCase();
      return tp === name || (name.startsWith('enterprise') && tp.startsWith('enterprise'));
    })?.price ?? '—'
  );
}
---

<BaseLayout
  title="Compare plans - GetNotify"
  description="Compare Foundation, Expansion, and Enterprise. WhatsApp accounts, brands, integrations, webhooks, API, users, and support — side by side."
>
  <section class="section bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <h1 class="heading-lg text-center mb-4">Compare plans</h1>
      <p class="text-center text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto mb-10">
        Clear limits for accounts, brands, integrations, and support — so you pick infrastructure that matches how you operate.
      </p>
      <p class="text-center text-xs text-neutral-500 dark:text-neutral-400 mb-4 sm:hidden">Scroll horizontally → to see all columns</p>
      <div class="overflow-x-auto compare-table-scroll -mx-4 px-4 sm:mx-0 sm:px-0 overflow-y-visible" style="scrollbar-gutter: stable;">
        <table class="w-full min-w-[800px] border border-neutral-200 dark:border-neutral-700 rounded-xl overflow-hidden">
          <thead>
            <tr class="bg-neutral-100 dark:bg-neutral-800">
              <th class="text-left p-4 font-semibold text-neutral-900 dark:text-white w-48">Feature</th>
              {planList.map((p) => {
                const priceDisplay = String(p.priceDisplay ?? '');
                const interval = String(p.interval ?? '');
                const setupLabel = String(p.setupLabel ?? 'Setup');
                const setupPrice = setupForPlan(p);
                const sub = interval === 'per month' ? '/ month' : '';
                return (
                  <th class="text-center p-4 font-semibold text-neutral-900 dark:text-white">
                    <span class="block">{String(p.name)}</span>
                    <span class="font-normal text-neutral-500 dark:text-neutral-400 text-sm block mt-0.5">{priceDisplay}{sub}</span>
                    <span class="font-normal text-neutral-500 dark:text-neutral-400 text-xs block mt-0.5">{setupLabel}: {setupPrice}</span>
                  </th>
                );
              })}
            </tr>
          </thead>
          <tbody>
            {comparison.categories?.flatMap((cat) => [
              <tr class="bg-neutral-50 dark:bg-neutral-800/60">
                <td colspan={planList.length + 1} class="font-semibold text-neutral-700 dark:text-neutral-300 p-3">
                  <span class="flex items-center gap-2">
                    <span aria-hidden="true">{cat.icon}</span>
                    {cat.name}
                  </span>
                </td>
              </tr>,
              ...(cat.features || []).map((f) => (
                <tr class="border-t border-neutral-200 dark:border-neutral-700 hover:bg-neutral-50/50 dark:hover:bg-neutral-800/30">
                  <td class="p-3 text-sm font-medium text-neutral-800 dark:text-neutral-200">{f.name}</td>
                  {planIds.map((id) => {
                    const value = String(f[id] ?? '—');
                    return (
                      <td class="p-3 text-sm text-center text-neutral-600 dark:text-neutral-400">
                        {value}
                      </td>
                    );
                  })}
                </tr>
              )),
            ])}
          </tbody>
        </table>
      </div>
      <p class="text-center mt-8 flex flex-wrap items-center justify-center gap-4">
        <a href="/pricing/" class="btn-primary">View pricing</a>
        <a href="/versus/" class="btn-outline">Compare vs competitors</a>
      </p>
    </div>
  </section>
</BaseLayout>
