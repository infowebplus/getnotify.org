---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import PricingPlansGrid from '../components/PricingPlansGrid.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const page = (await getCollection('pages')).find((e: CollectionEntry<'pages'>) => e.id === 'index');
const data = page?.data ?? { title: 'GetNotify', description: '' };
const globalsEntries = await getCollection('globals');
const globals = Object.fromEntries(globalsEntries.map((e: CollectionEntry<'globals'>) => [e.id, e.data]));
const company = (globals.company || {}) as Record<string, unknown>;
const features = (globals.features || {}) as Record<string, unknown>;
const content = (globals.content || {}) as Record<string, unknown>;

const featureList = (features.features || []) as Array<{ title: string; description: string; icon: string }>;
const featureListHome = featureList.slice(0, 4);
const steps = (content.steps || []) as Array<{ number: number; title: string; description: string }>;

const iconSvg: Record<string, string> = {
  message: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
  users: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
  upload: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>',
  video: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
  lock: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>',
  puzzle: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>',
};
---

<BaseLayout title={data.title} description={data.description}>
  <Hero company={company} />

  <section class="section bg-white dark:bg-neutral-900 border-b border-neutral-100 dark:border-neutral-800">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h2 class="heading-lg mb-3">Two different jobs</h2>
        <p class="text-body-sm text-neutral-600 dark:text-neutral-400">Conversation platforms manage chats. GetNotify connects your systems to WhatsApp for operational messaging.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto mb-8">
        <div class="rounded-2xl border border-neutral-200 dark:border-neutral-700 p-6 bg-neutral-50/70 dark:bg-neutral-800/40">
          <p class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-2">Conversation platforms</p>
          <h3 class="font-semibold text-neutral-900 dark:text-white mb-2">Shared inbox</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">For companies that want agents, support, sales, and marketing in one place.</p>
        </div>
        <div class="rounded-2xl border border-primary-500 ring-2 ring-primary-500/15 p-6 bg-primary-50/40 dark:bg-primary-950/20">
          <p class="text-xs font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400 mb-2">GetNotify</p>
          <h3 class="font-semibold text-neutral-900 dark:text-white mb-2">Transactional infrastructure</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">For companies that automate notifications, events, and operational WhatsApp from their own systems.</p>
        </div>
      </div>
      <p class="text-center">
        <a href="/versus/" class="link text-sm font-medium">See GetNotify vs respond.io, Twilio & 360dialog →</a>
      </p>
    </div>
  </section>

  <section id="features" class="section bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="heading-lg mb-3">What you get</h2>
        <p class="text-body-sm text-neutral-600 dark:text-neutral-400">Dashboard, API, webhooks — on your Meta account. Built for transactional messages: orders, alerts, OTPs. You pay Meta; we don't markup.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {featureListHome.map((f) => (
          <div class="card card-hover py-5 px-5" data-animate>
            <div class="w-10 h-10 bg-primary-100 dark:bg-primary-900/50 rounded-lg flex items-center justify-center mb-3" set:html={iconSvg[f.icon] || ''} />
            <h3 class="font-semibold text-neutral-900 dark:text-white mb-1">{f.title}</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50 dark:bg-neutral-800">
    <div class="container-custom">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="heading-lg mb-3">How it works</h2>
        <p class="text-body-sm text-neutral-600 dark:text-neutral-400">Connect. Configure. Send.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {steps.map((step) => (
          <div class="text-center" data-animate>
            <div class="w-14 h-14 bg-primary-500 text-white rounded-xl flex items-center justify-center text-xl font-bold mx-auto mb-4">{step.number}</div>
            <h3 class="font-semibold text-neutral-900 dark:text-white mb-2">{step.title}</h3>
            <p class="text-sm text-neutral-600 dark:text-neutral-400">{step.description}</p>
          </div>
        ))}
      </div>
      <p class="text-center mt-8">
        <a href="/onboarding/" class="link text-sm">See onboarding details →</a>
      </p>
    </div>
  </section>

  <section class="section bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <div class="text-center max-w-xl mx-auto mb-12">
        <h2 class="heading-lg mb-3">Pricing</h2>
        <p class="text-body-sm text-neutral-600 dark:text-neutral-400">Setup once. Subscribe for infrastructure. Meta bills messaging separately — no markup.</p>
      </div>
      <PricingPlansGrid showCompareLink={false} />
      <div class="text-center mt-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
        <a href="/pricing/" class="link text-sm font-medium">Full pricing & calculator →</a>
        <a href="/compare-plans/" class="link text-sm font-medium">Compare plans →</a>
      </div>
    </div>
  </section>

  <section class="section bg-gradient-to-br from-primary-600 to-primary-800">
    <div class="container-custom text-center">
      <h2 class="heading-lg text-white mb-3">Get started</h2>
      <p class="text-primary-100 mb-8 max-w-xl mx-auto">Official WhatsApp Cloud API on your account. We provide the layer; you send what matters.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/register/" class="btn bg-white text-primary-700 hover:bg-neutral-100 btn-lg">Create account</a>
        <a href="/pricing/" class="btn border-2 border-white/30 text-white hover:bg-white/10 btn-lg">Pricing</a>
        <a href="/contact/" class="btn border-2 border-white/30 text-white hover:bg-white/10 btn-lg">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>
