---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';

const page = (await getCollection('pages')).find((e: CollectionEntry<'pages'>) => e.id === 'index');
const data = page?.data ?? { title: 'GetNotify', description: '' };
const globalsEntries = await getCollection('globals');
const globals = Object.fromEntries(globalsEntries.map((e: CollectionEntry<'globals'>) => [e.id, e.data]));
const company = (globals.company || {}) as Record<string, unknown>;
const features = (globals.features || {}) as Record<string, unknown>;
const content = (globals.content || {}) as Record<string, unknown>;
const plans = (globals.plans || {}) as Record<string, unknown>;
const faq = (globals.faq || {}) as Record<string, unknown>;

const featureList = (features.features || []) as Array<{ title: string; description: string; icon: string }>;
const steps = (content.steps || []) as Array<{ number: number; title: string; description: string }>;
const planList = (plans.plans || []) as Array<Record<string, unknown>>;
const faqCategories = (faq.categories || []) as Array<{ name: string; questions: Array<{ id: string; question: string; answer: string }> }>;
const faqPreview = faqCategories.flatMap((c) => c.questions).slice(0, 4);

const iconSvg: Record<string, string> = {
  message: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>',
  users: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>',
  upload: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/></svg>',
  video: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/></svg>',
  lock: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>',
  puzzle: '<svg class="w-6 h-6 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"/></svg>',
};
---

<BaseLayout title={data.title} description={data.description}>
  <Hero company={company} />

  <section id="features" class="section bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="badge-primary mb-4">Features</span>
        <h2 class="heading-lg mb-4">Everything you need to collaborate</h2>
        <p class="text-body">Powerful features designed to help your team communicate efficiently and get more done together.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        {featureList.map((f) => (
          <div class="card card-hover" data-animate>
            <div class="w-12 h-12 bg-primary-100 dark:bg-primary-900/50 rounded-xl flex items-center justify-center mb-4" set:html={iconSvg[f.icon] || ''} />
            <h3 class="heading-sm mb-2">{f.title}</h3>
            <p class="text-body-sm">{f.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50 dark:bg-neutral-800">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="badge-primary mb-4">How It Works</span>
        <h2 class="heading-lg mb-4">Get started in minutes</h2>
        <p class="text-body">No complicated setup. Just sign up, invite your team, and start collaborating.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8">
        {steps.map((step) => (
          <div class="text-center" data-animate>
            <div class="w-16 h-16 bg-primary-500 text-white rounded-2xl flex items-center justify-center text-2xl font-bold mx-auto mb-6 shadow-lg shadow-primary-500/30">{step.number}</div>
            <h3 class="heading-sm mb-3">{step.title}</h3>
            <p class="text-body-sm">{step.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section bg-white dark:bg-neutral-900">
    <div class="container-custom">
      <div class="text-center max-w-2xl mx-auto mb-16">
        <span class="badge-primary mb-4">Pricing</span>
        <h2 class="heading-lg mb-4">Plans for every team size</h2>
        <p class="text-body">Start free and scale as you grow. No hidden fees, cancel anytime.</p>
      </div>
      <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">
        {planList.map((plan) => {
          const rec = Boolean(plan.recommended);
          const priceObj = plan.priceDisplay as { monthly?: string } | null | undefined;
          const priceDisplay = typeof priceObj === 'object' && priceObj && typeof priceObj.monthly === 'string'
            ? priceObj.monthly
            : String(plan.priceDisplay ?? '');
          const cta = plan.cta as { href?: string; text?: string } | null | undefined;
          return (
            <div class={`plan-card ${rec ? 'plan-card-recommended' : ''}`} data-plan={plan.id} data-price-monthly={priceDisplay}>
              {rec && <span class="badge-primary absolute top-4 right-4">Most Popular</span>}
              <div class="mb-6">
                <h3 class="text-xl font-bold text-neutral-900 dark:text-white mb-2">{String(plan.name)}</h3>
                <p class="text-sm text-neutral-600 dark:text-neutral-400">{String(plan.description)}</p>
              </div>
              <div class="mb-6">
                <span class="plan-price text-4xl font-bold text-neutral-900 dark:text-white">{priceDisplay}</span>
                {plan.interval !== 'forever' && <span class="plan-interval text-neutral-500 dark:text-neutral-400 text-sm">/{(plan.interval as string) === 'per month' ? 'month' : (plan.interval as string)}</span>}
              </div>
              <ul class="space-y-3 mb-8">
                {(plan.features as string[] || []).map((f) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-primary-500 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span class="text-sm text-neutral-600 dark:text-neutral-400">{f}</span>
                  </li>
                ))}
              </ul>
              <a href={String(cta?.href ?? '/register/')} class={rec ? 'btn-primary w-full' : 'btn-outline w-full'}>{cta?.text ?? 'Get Started'}</a>
            </div>
          );
        })}
      </div>
      <div class="text-center mt-12">
        <a href="/compare-plans/" class="link text-sm font-medium">Compare all plans in detail →</a>
      </div>
    </div>
  </section>

  <section class="section bg-neutral-50 dark:bg-neutral-800">
    <div class="container-custom">
      <div class="max-w-3xl mx-auto">
        <div class="text-center mb-12">
          <span class="badge-primary mb-4">FAQ</span>
          <h2 class="heading-lg mb-4">Frequently asked questions</h2>
          <p class="text-body">Find quick answers to common questions about {String(company.name)}.</p>
        </div>
        <div class="card">
          {faqPreview.map((q) => (
            <div class="faq-item" id={`faq-${q.id}`}>
              <button type="button" class="faq-button" aria-expanded="false" aria-controls={`answer-${q.id}`}>
                <span>{q.question}</span>
                <svg class="faq-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="faq-answer" id={`answer-${q.id}`} aria-hidden="true"><p>{q.answer}</p></div>
            </div>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/faq/" class="link text-sm font-medium">View all FAQs →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-gradient-to-br from-primary-600 to-primary-800">
    <div class="container-custom text-center">
      <h2 class="heading-lg text-white mb-4">Ready to transform your team communication?</h2>
      <p class="text-primary-100 text-lg mb-8 max-w-2xl mx-auto">Join thousands of teams already using {String(company.name)} to work better together.</p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="/register/" class="btn bg-white text-primary-700 hover:bg-neutral-100 btn-lg">Start Free Trial</a>
        <a href="/contact/" class="btn border-2 border-white/30 text-white hover:bg-white/10 btn-lg">Contact Sales</a>
      </div>
    </div>
  </section>
</BaseLayout>
