---
interface Props {
  nav: Record<string, unknown>;
  currentPath: string;
  dashboardLoginUrl?: string;
  dashboardRegisterUrl?: string;
}
const { nav, currentPath, dashboardLoginUrl = '', dashboardRegisterUrl = '' } = Astro.props;
const brand = (nav.brand || {}) as Record<string, string>;
const items = (nav.items || []) as Array<{ label: string; href: string; external?: boolean }>;
const cta = (nav.cta || {}) as Record<string, string>;
const auth = (nav.auth || {}) as Record<string, Record<string, string>>;
const loginHref = (dashboardLoginUrl || auth.login?.href) ?? '/login/';
const ctaHref = (dashboardRegisterUrl || cta.href) ?? '/register/';
const ctaLabel = cta.label ?? 'Get Started';
const loginExternal = Boolean(dashboardLoginUrl);
const ctaExternal = Boolean(dashboardRegisterUrl);

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/' || currentPath === '';
  return currentPath === href || currentPath === href.replace(/\/$/, '');
}
---

<header id="header" class="fixed top-0 left-0 right-0 z-50 bg-white/95 dark:bg-neutral-900/95 backdrop-blur-md border-b border-neutral-200/80 dark:border-neutral-800 transition-all duration-300 shadow-sm dark:shadow-none">
  <div class="container-custom">
    <nav class="flex items-center justify-between h-18 py-4">
      <a href="/" class="flex items-center group">
        <img src={brand.logo ?? '/assets/img/logo.svg'} alt={brand.name ?? 'GetNotify'} class="h-11 w-auto group-hover:scale-[1.02] transition-transform duration-200 dark:hidden" width="240" height="60" />
        <img src="/assets/img/logo-light.svg" alt={brand.name ?? 'GetNotify'} class="h-11 w-auto group-hover:scale-[1.02] transition-transform duration-200 hidden dark:block" width="240" height="60" />
      </a>

      <div class="hidden md:flex items-center gap-8">
        {items.map((item) => {
          const active = isActive(item.href);
          const cls = active ? 'text-primary-600 dark:text-primary-400' : 'text-neutral-600 dark:text-neutral-400';
          return (
            <a href={item.href} class={`text-sm font-medium ${cls} hover:text-primary-600 dark:hover:text-primary-300 transition-colors`} {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
              {item.label}
            </a>
          );
        })}
      </div>

      <div class="hidden md:flex items-center gap-3">
        <button id="dark-mode-toggle" class="p-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-lg transition-colors" aria-label="Toggle dark mode">
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <a href={loginHref} class="text-sm font-medium text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors" {...(loginExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Log In</a>
        <a href={ctaHref} class="btn-primary btn-sm shadow-lg shadow-primary-500/20 dark:shadow-primary-500/30" {...(ctaExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{ctaLabel}</a>
      </div>

      <div class="flex md:hidden items-center gap-1">
        <button id="dark-mode-toggle-mobile" class="p-2 text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white rounded-lg" aria-label="Toggle dark mode">
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
        <button id="mobile-menu-btn" class="p-2 text-neutral-600 dark:text-neutral-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-lg" aria-label="Open menu" aria-expanded="false">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>
    </nav>
  </div>

  <div id="mobile-nav" class="mobile-nav md:hidden">
    <div class="flex flex-col h-full bg-white dark:bg-neutral-950">
      <div class="flex items-center justify-between p-4 border-b border-neutral-200 dark:border-neutral-800">
        <a href="/" class="flex items-center">
          <img src={brand.logo ?? '/assets/img/logo.svg'} alt={brand.name ?? 'GetNotify'} class="h-11 w-auto dark:hidden" width="240" height="60" />
          <img src="/assets/img/logo-light.svg" alt={brand.name ?? 'GetNotify'} class="h-11 w-auto hidden dark:block" width="240" height="60" />
        </a>
        <button id="mobile-nav-close" class="p-2 rounded-lg" aria-label="Close menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto p-4 bg-neutral-50 dark:bg-neutral-900 space-y-1">
        {items.map((item) => (
          <a href={item.href} class="mobile-nav-link block px-4 py-3 text-lg font-medium text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-800 rounded-xl" {...(item.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{item.label}</a>
        ))}
      </div>
      <div class="p-4 border-t border-neutral-200 dark:border-neutral-800 space-y-3">
        <a href={loginHref} class="btn-secondary w-full block text-center" {...(loginExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>Log In</a>
        <a href={ctaHref} class="btn-primary w-full block text-center" {...(ctaExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{ctaLabel}</a>
      </div>
    </div>
  </div>
</header>

<div class="h-18 pt-4"></div>
