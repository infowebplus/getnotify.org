---
/**
 * GDPR/EU cookie consent banner. Shown when Cookiebot is not configured and user has not yet chosen.
 * Consent is stored in localStorage; optional scripts (analytics) should check window.__cookieConsent.
 */
const cookiePolicyUrl = '/legal/cookies/';
const privacyPolicyUrl = '/legal/privacy/';
const manageHash = '#manage';
---

<div id="cookie-banner" class="cookie-banner" role="dialog" aria-label="Cookie consent" aria-describedby="cookie-banner-desc" hidden>
  <div class="cookie-banner-inner">
    <p id="cookie-banner-desc" class="cookie-banner-text">
      We use cookies for essential site function (e.g. theme, consent) and optional analytics to improve the site. You can accept all, reject non-essential, or manage preferences. See our <a href={cookiePolicyUrl} class="cookie-banner-link">Cookie Policy</a> and <a href={privacyPolicyUrl} class="cookie-banner-link">Privacy Policy</a>.
    </p>
    <div class="cookie-banner-actions">
      <button type="button" id="cookie-accept-all" class="cookie-banner-btn cookie-banner-btn-primary">Accept all</button>
      <button type="button" id="cookie-reject-non-essential" class="cookie-banner-btn cookie-banner-btn-secondary">Reject non-essential</button>
      <a href={`${cookiePolicyUrl}${manageHash}`} class="cookie-banner-btn cookie-banner-btn-outline">Manage preferences</a>
    </div>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 9999;
    padding: 1rem 1.25rem;
    background: var(--color-neutral-900, #171717);
    color: var(--color-neutral-100, #f5f5f5);
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.2);
  }
  .cookie-banner-inner {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    align-items: flex-start;
  }
  .cookie-banner-text {
    font-size: 0.875rem;
    line-height: 1.5;
    margin: 0;
    color: var(--color-neutral-200, #e5e5e5);
  }
  .cookie-banner-link {
    color: var(--color-primary-400, #4ade80);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cookie-banner-link:hover {
    color: var(--color-primary-300, #86efac);
  }
  .cookie-banner-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .cookie-banner-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background-color 0.15s, color 0.15s;
    border: none;
    text-decoration: none;
  }
  .cookie-banner-btn-primary {
    background: var(--color-primary-500, #22c55e);
    color: #fff;
  }
  .cookie-banner-btn-primary:hover {
    background: var(--color-primary-600, #16a34a);
  }
  .cookie-banner-btn-secondary {
    background: transparent;
    color: var(--color-neutral-200, #e5e5e5);
    border: 1px solid var(--color-neutral-600, #525252);
  }
  .cookie-banner-btn-secondary:hover {
    background: var(--color-neutral-800, #262626);
  }
  .cookie-banner-btn-outline {
    background: transparent;
    color: var(--color-primary-400, #4ade80);
    border: 1px solid var(--color-primary-500, #22c55e);
  }
  .cookie-banner-btn-outline:hover {
    background: rgba(34, 197, 94, 0.1);
  }
  @media (min-width: 640px) {
    .cookie-banner-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .cookie-banner-actions {
      flex-shrink: 0;
    }
  }
</style>

<script define:vars={{ cookiePolicyUrl, manageHash }}>
  const CONSENT_KEY = 'cookie_consent';
  const CONSENT_TS_KEY = 'cookie_consent_timestamp';

  function getConsent() {
    try {
      const raw = localStorage.getItem(CONSENT_KEY);
      if (!raw) return null;
      const v = JSON.parse(raw);
      return { necessary: true, analytics: !!v.analytics, marketing: !!v.marketing };
    } catch {
      return null;
    }
  }

  function setConsent(necessary, analytics, marketing) {
    localStorage.setItem(CONSENT_KEY, JSON.stringify({ necessary, analytics, marketing }));
    localStorage.setItem(CONSENT_TS_KEY, String(Date.now()));
    window.__cookieConsent = { necessary, analytics, marketing };
  }

  function hideBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.hidden = true;
  }

  function showBanner() {
    const banner = document.getElementById('cookie-banner');
    if (banner) banner.hidden = false;
  }

  (function init() {
    const existing = getConsent();
    if (existing) {
      window.__cookieConsent = existing;
      hideBanner();
      return;
    }
    if (typeof window.Cookiebot !== 'undefined') {
      hideBanner();
      return;
    }
    showBanner();
    document.getElementById('cookie-accept-all')?.addEventListener('click', () => {
      setConsent(true, true, true);
      hideBanner();
      if (typeof window.__enableGetNotifyAnalytics === 'function') window.__enableGetNotifyAnalytics();
    });
    document.getElementById('cookie-reject-non-essential')?.addEventListener('click', () => {
      setConsent(true, false, false);
      hideBanner();
    });
  })();

  window.addEventListener('cookie-consent-show', function reopen() {
    localStorage.removeItem(CONSENT_KEY);
    localStorage.removeItem(CONSENT_TS_KEY);
    delete window.__cookieConsent;
    showBanner();
  });
</script>
