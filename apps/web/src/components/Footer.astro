---
interface Props {
  footer: Record<string, unknown>;
}
const { footer } = Astro.props;

const description = String(footer.description ?? '');
const cta = (footer.cta || {}) as Record<string, string>;
const ctaLabel = cta.label ?? 'Get started';
const ctaHref = cta.href ?? '/register/';
const columns = (footer.columns || []) as Array<{ title: string; links: Array<{ label: string; href: string; external?: boolean }> }>;
const social = (footer.social || []) as Array<{ name: string; href: string; icon: string }>;
const copyright = String(footer.copyright ?? '');
const legalLine = String(footer.legalLine ?? '');
const legalUrl = String(footer.legalUrl ?? '');
const invoiceLine = String(footer.invoiceLine ?? '');
const socialIconPaths: Record<string, string> = {
  twitter: '<path d="M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z"/>',
  linkedin: '<path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/>',
  github: '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 00-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 005 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 009 18.13V22"/>',
};
---

<footer class="bg-neutral-100/80 dark:bg-neutral-900/80 border-t border-neutral-200/80 dark:border-neutral-800">
  <div class="container-custom">
    <!-- Brand + CTA strip -->
    <div class="py-14 md:py-16 border-b border-neutral-200/80 dark:border-neutral-800">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-10">
        <div class="max-w-md">
          <a href="/" class="inline-flex items-center mb-4">
            <img src="/assets/img/logo.svg" alt="GetNotify" class="h-10 w-auto dark:hidden" width="200" height="52" />
            <img src="/assets/img/logo-light.svg" alt="GetNotify" class="h-10 w-auto hidden dark:block" width="200" height="52" />
          </a>
          <p class="text-body-sm text-neutral-600 dark:text-neutral-400">
            {description}
          </p>
        </div>
        <div class="shrink-0">
          <a href={ctaHref} class="btn-primary btn-lg shadow-lg shadow-primary-500/20 dark:shadow-primary-500/25">
            {ctaLabel}
          </a>
        </div>
      </div>
    </div>

    <!-- Link columns -->
    <div class="py-12 md:py-14">
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-8 lg:gap-12">
        {columns.map((col) => (
          <div>
            <h4 class="text-xs font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400 mb-4">
              {col.title}
            </h4>
            <ul class="space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                    {...(link.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="py-6 border-t border-neutral-200/80 dark:border-neutral-800">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div class="order-2 sm:order-1 space-y-1">
          <p class="text-sm text-neutral-500 dark:text-neutral-400">
            {copyright}
          </p>
          {legalLine && (
            <p class="text-xs text-neutral-400 dark:text-neutral-500">
              {legalUrl ? (
                <a href={legalUrl} target="_blank" rel="noopener noreferrer" class="hover:text-neutral-600 dark:hover:text-neutral-400 transition-colors">{legalLine}</a>
              ) : (
                <span>{legalLine}</span>
              )}
            </p>
          )}
          {invoiceLine && (
            <p class="text-xs text-neutral-400 dark:text-neutral-500">{invoiceLine}</p>
          )}
        </div>
        <div class="flex items-center gap-2 order-1 sm:order-2">
          {social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center justify-center w-10 h-10 rounded-xl text-neutral-500 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-primary-50 dark:hover:bg-primary-950/50 transition-colors duration-200"
              aria-label={s.name}
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" set:html={socialIconPaths[s.icon] || ''}></svg>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer>
