---
interface Props {
  company: Record<string, unknown>;
}
const { company } = Astro.props;
const description = String(company.description ?? '');
---

<section class="relative overflow-hidden bg-gradient-hero">
  <div class="absolute inset-0 pattern-grid opacity-50"></div>
  <div class="absolute top-20 left-10 w-72 h-72 bg-primary-400/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent-400/20 rounded-full blur-3xl"></div>

  <div class="container-custom relative">
    <div class="py-20 md:py-32 lg:py-40 text-center max-w-4xl mx-auto">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 shadow-soft mb-8 backdrop-blur-sm">
        <span class="w-2 h-2 rounded-full bg-primary-500 animate-pulse"></span>
        <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Coming Soon: Shopify Plugin</span>
      </div>

      <h1 class="heading-xl mb-6">
        <span class="text-neutral-900 dark:text-white">Send notifications via</span>
        <br />
        <span class="text-gradient">WhatsApp messages</span>
      </h1>

      <p class="text-body text-lg md:text-xl max-w-2xl mx-auto mb-10">{description}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/register/" class="btn-primary btn-lg w-full sm:w-auto">
          Get Started Free
          <svg class="w-5 h-5 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/pricing/" class="btn-outline btn-lg w-full sm:w-auto">View Pricing</a>
      </div>

      <div class="flex flex-col items-center gap-4">
        <div class="flex items-center -space-x-2">
          <div class="w-10 h-10 rounded-full bg-neutral-200 dark:bg-neutral-700 border-2 border-white dark:border-neutral-900"></div>
          <div class="w-10 h-10 rounded-full bg-neutral-300 dark:bg-neutral-600 border-2 border-white dark:border-neutral-900"></div>
          <div class="w-10 h-10 rounded-full bg-neutral-400 dark:bg-neutral-500 border-2 border-white dark:border-neutral-900"></div>
          <div class="w-10 h-10 rounded-full bg-primary-500 border-2 border-white dark:border-neutral-900 flex items-center justify-center"><span class="text-xs font-bold text-white">+5k</span></div>
        </div>
        <p class="text-sm text-neutral-500 dark:text-neutral-400">
          Trusted by <strong class="text-neutral-700 dark:text-neutral-200">hundreds</strong> of businesses worldwide
        </p>
      </div>
    </div>
  </div>
</section>
