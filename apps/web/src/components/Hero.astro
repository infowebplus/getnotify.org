---
interface Props {
  company: Record<string, unknown>;
}
const { company } = Astro.props;
const description = String(company.description ?? '');
---

<section class="relative overflow-hidden bg-gradient-hero">
  <div class="absolute inset-0 pattern-grid opacity-50"></div>
  <div class="absolute top-20 left-10 w-72 h-72 bg-primary-400/20 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-96 h-96 bg-accent-400/20 rounded-full blur-3xl"></div>

  <div class="container-custom relative">
    <div class="py-20 md:py-32 lg:py-40 text-center max-w-4xl mx-auto">
      <h1 class="heading-xl mb-6">
        <span class="text-neutral-900 dark:text-white">WhatsApp Cloud API.</span>
        <br />
        <span class="text-gradient">Your account. No markup.</span>
      </h1>

      <p class="text-body text-lg md:text-xl max-w-2xl mx-auto mb-10">{description}</p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href="/register/" class="btn-primary btn-lg w-full sm:w-auto">
          Get started
          <svg class="w-5 h-5 ml-2 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
        <a href="/pricing/" class="btn-outline btn-lg w-full sm:w-auto">Pricing</a>
      </div>

      <p class="text-sm text-neutral-500 dark:text-neutral-400">
        Simple. Transparent. Yours.
      </p>
    </div>
  </div>
</section>
