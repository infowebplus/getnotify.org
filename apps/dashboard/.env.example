APP_NAME="GetNotify Dashboard"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://dashboard.getnotify.org

# Public site origin (for CORS / API if needed)
PUBLIC_SITE_ORIGIN=https://getnotify.org

# Database (SQLite for simple setup)
DB_CONNECTION=sqlite
# DB_DATABASE=absolute/path/to/database.sqlite
# Or MySQL:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dashboard
# DB_USERNAME=root
# DB_PASSWORD=

# Session (use cookie for dashboard; ensure secure in prod)
SESSION_DRIVER=database
SESSION_LIFETIME=120

# Cache (file or redis in prod)
CACHE_STORE=file
# QUEUE_CONNECTION=sync

# Filament
FILAMENT_FILESYSTEM_DISK=local

# Optional: for future content API (build-time secret)
# DASHBOARD_BUILD_SECRET=
