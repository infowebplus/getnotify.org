{
  "name": "getnotify-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "description": "GetNotify yarn — Astro static site + Filament dashboard monorepo",
  "workspaces": ["apps/*"],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@getnotify/web --filter=@getnotify/docs",
    "dev:web": "turbo run dev --filter=@getnotify/web",
    "dev:docs": "turbo run dev --filter=@getnotify/docs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean --force && rimraf node_modules"
  },
  "devDependencies": {
    "rimraf": "^5.0.5",
    "turbo": "^2.3.0"
  },
  "engines": {
    "node": ">=20"
  }
}
